{
  "name": "cyber-cat-slot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CYBER CAT - slot web front (Crownforge), Stake Engine ready",
  "scripts": {
    "dev": "vite --port 5340 --strictPort",
    "build": "vite build --mode production --outDir dist-public",
    "build:qa": "vite build --mode qa --outDir dist-qa && node tools/qa-extras.mjs dist-qa",
    "preview": "vite preview --outDir dist-qa --port 5341 --strictPort",
    "preview:public": "vite preview --outDir dist-public --port 5342 --strictPort",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "fixtures": "tsx tools/fixtures/build.ts",
    "fixtures:check": "tsx tools/fixtures/check.ts",
    "cat:prepare": "node tools/cat-prepare.mjs",
    "cat:sheets": "node tools/cat-sheets.mjs",
    "cat:poses": "node tools/cat-poses.mjs",
    "cat:proof": "node tools/cat-proof.mjs",
    "cat:testrig": "node tools/test-rig/make-test-rig.mjs",
    "assets": "node tools/assets/process.mjs",
    "audio": "node tools/audio/render.mjs",
    "shot": "node tools/shot.mjs",
    "record": "node tools/record.mjs",
    "hud-check": "node tools/hud-check.mjs",
    "e2e": "node tools/play-e2e.mjs",
    "check-release": "node tools/check-release.mjs",
    "serve-stable": "node tools/serve-stable.mjs",
    "package": "node tools/package-delivery.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "pixi.js": "^8.21.0",
    "three": "^0.186.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/oxanium": "^5.3.0",
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.10.0",
    "@types/three": "^0.186.0",
    "ffmpeg-static": "^5.3.0",
    "meshoptimizer": "^1.0.1",
    "playwright-core": "1.56.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
