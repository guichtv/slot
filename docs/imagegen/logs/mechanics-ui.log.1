codex
Le contrôle du canal alpha corrige mon observation sur les halos : les zones colorées autour des sujets testées dans les PNG ont un alpha nul, même si elles apparaissent dans l’aperçu. Les six images sont enregistrées avec leurs prompts. Les écarts restants concernent surtout les résolutions carrées, certaines marges et la taille des éléments.

exec
/bin/bash -lc "python - <<'PY'
from PIL import Image
from collections import deque
for name in ['fx/fx-debris.png','fx/fx-dust.png','ui/topbar.png']:
 im=Image.open('assets/generated/'+name); w,h=im.size; mask=bytearray(v>128 for v in im.getchannel('A').getdata()); boxes=[]
 for start in range(w*h):
  if not mask[start]: continue
  mask[start]=0; q=deque([start]); n=0; x0=w;y0=h;x1=y1=0
  while q:
   i=q.popleft(); y,x=divmod(i,w); n+=1; x0=min(x0,x);x1=max(x1,x);y0=min(y0,y);y1=max(y1,y)
   for j in ((i-1 if x else -1),(i+1 if x<w-1 else -1),i-w,i+w):
    if 0<=j<w*h and mask[j]: mask[j]=0;q.append(j)
  if n>1000: boxes.append((x0,y0,x1+1,y1+1))
 print(name,boxes)
PY" in /home/user/slot
