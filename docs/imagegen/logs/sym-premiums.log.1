from PIL import Image
from pathlib import Path
import json
for p in sorted(Path('assets/generated/symbols').glob('*.png')):
 im=Image.open(p); a=im.getchannel('A'); solid=a.point(lambda x:255 if x>128 else 0)
 print(json.dumps({'file':str(p),'size':im.size,'mode':im.mode,'alpha_range':a.getextrema(),'bbox_alpha':a.getbbox(),'bbox_alpha_over128':solid.getbbox(),'transparent_pixels':a.histogram()[0],'prompt':p.with_suffix('.prompt.txt').exists()}))
PY
