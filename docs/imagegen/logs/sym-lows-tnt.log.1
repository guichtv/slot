 print(n,im.size,im.mode,'alpha',a.getextrema(),'bbox_visible',box,'marge_min_pct',round(100*min(box[0]/w,box[1]/h,(w-box[2])/w,(h-box[3])/h),2),'prompt',p.with_suffix('.prompt.txt').exists())
PY" in /home/user/slot
