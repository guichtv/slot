from PIL import Image
from pathlib import Path
import json
for p in sorted(Path('assets/generated/screens').glob('*.png')):
 im=Image.open(p); a=im.getchannel('A'); w,h=im.size
 bbox=a.point(lambda v:255 if v>127 else 0).getbbox()
 print(json.dumps({'file':p.name,'size':im.size,'mode':im.mode,'alpha_range':a.getextrema(),'bbox_alpha_gt127':bbox,'margins_percent':[round(100*bbox[0]/w,1),round(100*bbox[1]/h,1),round(100*(w-bbox[2])/w,1),round(100*(h-bbox[3])/h,1)],'center_RGBA':im.getpixel((w//2,h//2))}))
PY" in /home/user/slot
