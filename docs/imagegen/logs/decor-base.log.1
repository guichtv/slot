 if 'A' in im.getbands():
  a=im.getchannel('A');h=a.histogram()
  print('transparent percent',round(h[0]*100/(im.width*im.height),2),'bbox alpha>128',a.point(lambda x:255 if x>128 else 0).getbbox())
